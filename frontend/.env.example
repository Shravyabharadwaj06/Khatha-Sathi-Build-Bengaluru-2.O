# Copy to .env (never commit .env).
# false -> calls the local FastAPI backend
# true  -> uses the in-browser mock (no backend needed; the voice assistant mock understands the demo phrases)
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:8000

# Voice input for the AI assistant (/assistant):
#   gnani   -> record audio in the browser (converted to 16 kHz mono WAV) and send it to the backend,
#              which transcribes it with Gnani. Uses Gnani credits. Use this for demos.
#   browser -> use the browser's own speech recognition (Web Speech API, works best in Chrome) and send
#              only the text. Uses NO Gnani credits. Use this while developing.
VITE_VOICE_INPUT=browser

# Optional: IndicTrans2 translation server used by src/i18n/translationService.ts for the
# Hindi/Kannada/Urdu UI text. Not part of this repo; leave empty to use the built-in locale files only.
VITE_INDICTRANS2_API_URL=
