# Copy to frontend/.env (never commit .env). Restart `npm run dev` after changing it.
# Only VITE_* values reach the browser, so NEVER put a secret key here.

# true  -> everything uses the in-browser mock (no backend needed; good for UI work)
# false -> pages call the FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=false

# Where the FastAPI backend runs (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# AI Assistant only:
# true  -> the assistant uses the in-browser voice mock (no Gnani credits), even when VITE_USE_MOCK_API=false
# false -> the assistant calls the backend /voice/* endpoints (the backend talks to Gnani)
VITE_USE_MOCK_VOICE=true

# How the assistant hears you:
#   gnani   -> record audio, convert to 16 kHz mono WAV and send it to the backend (uses Gnani credits)
#   browser -> the browser's own speech recognition (Chrome); only text is sent (no Gnani credits)
VITE_VOICE_INPUT=browser

# Optional: IndicTrans2 translation server used by src/i18n/translationService.ts for the
# Hindi/Kannada/Urdu UI text. Not part of this repo; leave empty to use the built-in locale files.
VITE_INDICTRANS2_API_URL=
