# Copy to backend/.env and fill in the values (never commit backend/.env).
# Everything here stays on the server. The browser never sees these values.

# ------------------------------------------------------------------ Supabase
# Project URL: Dashboard -> Project Settings -> Data API (https://<project-ref>.supabase.co)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): Dashboard -> Project Settings -> API Keys. Used for sign-in / refresh.
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Secret / service-role key: Dashboard -> Project Settings -> API Keys. SERVER ONLY: it bypasses Row Level Security.
# Used only to create users at sign-up and for Storage (uploads + signed URLs).
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_... or service_role key>
# Postgres via the Session pooler (IPv4, port 5432): Dashboard -> Connect -> Session pooler.
# Keep the postgresql+psycopg:// prefix and put your database password in place of <password>.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<N>-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------ Web
# Browser origins allowed to call this API (comma separated). Default: the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ Phone OTP (sign up)
# dev = no SMS is sent; the code below works for every phone (local development only).
OTP_MODE=dev
# Six digits, e.g. 123456. Only used when OTP_MODE=dev.
DEV_OTP_CODE=<six-digit-code>

# ------------------------------------------------------------------ Voice (Gnani / Vachana)
# gnani = real speech-to-text / text-to-speech (uses credits); mock = fake, free (tests, CI, UI work).
ASR_PROVIDER=mock
TTS_PROVIDER=mock
# Gnani API key (sent as the X-API-Key-ID header). Get it at https://app.gnani.ai/voice/ . SERVER ONLY.
GNANI_API_KEY=
# Credit guard: total seconds of audio sent to Gnani per day (all shops). 0 = voice off.
GNANI_DAILY_LIMIT_SECONDS=600
# Longest clip accepted, in seconds (the app records at most 15).
VOICE_MAX_CLIP_SECONDS=15

# ------------------------------------------------------------------ Intent understanding (optional LLM)
# rules = built-in rules only (works offline, default) | llm = LLM only | auto = LLM first, rules if it fails.
INTENT_MODE=rules
# Any OpenAI-compatible chat-completions API (Gemini, Groq, OpenAI...). Leave empty to use rules only.
# Only the typed/heard TEXT plus customer/product names are sent to the LLM, never audio, never amounts to compute.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
