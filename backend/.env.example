# Copy to backend/.env and fill in values through a private channel.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require

# Local development OTP only. Do not use this mode in production.
OTP_MODE=dev
DEV_OTP_CODE=<six-digit-development-code>
