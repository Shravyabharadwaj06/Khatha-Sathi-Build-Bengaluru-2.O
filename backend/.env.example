# Copy to backend/.env and fill in the values (never commit backend/.env).
# Everything here stays on the server. The browser never sees these values.
# Any value still containing <...> is treated as NOT configured: the backend logs a warning
# at start-up and answers 503 naming the variable (GET /health/ready shows the database state).

# ------------------------------------------------------------------ Supabase (all four REQUIRED)
# Project URL: Dashboard -> Project Settings -> Data API (https://<project-ref>.supabase.co)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): Dashboard -> Project Settings -> API Keys. Used for sign-in / refresh.
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Secret / service-role key: Dashboard -> Project Settings -> API Keys. SERVER ONLY: it bypasses Row Level Security.
# Used only to create users at sign-up and for Storage (uploads + signed URLs).
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_... or service_role key>
# Postgres via the SESSION POOLER: Dashboard -> Connect (top bar) -> "Session pooler" -> copy the URI.
#   - Use the pooler host (aws-<N>-ap-northeast-2.pooler.supabase.com, port 5432, user postgres.<project-ref>),
#     NOT db.<project-ref>.supabase.co (the direct host is IPv6-only and fails on most home networks).
#   - Change the copied prefix postgresql:// to postgresql+psycopg:// (the backend refuses other drivers).
#   - Put the database password in place of <password>. If it contains @ : / ? # % or &, URL-encode it
#     (e.g. @ -> %40). Forgot it? Dashboard -> Project Settings -> Database -> Reset database password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<N>-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------ Web
# Browser origins allowed to call this API (comma separated, no trailing slash). Default: the Vite dev server.
# Add every origin you open the app from, e.g. http://localhost:4173 for `npm run preview`.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ Phone OTP (sign up)
# dev = no SMS is sent; the code below works for every phone (local development only).
# No SMS provider is implemented yet: any other value turns sign-up OFF (503).
OTP_MODE=dev
# Six digits, e.g. 123456. Only used when OTP_MODE=dev.
DEV_OTP_CODE=<six-digit-code>

# ------------------------------------------------------------------ Voice (Gnani / Vachana)
# gnani = real speech-to-text / text-to-speech (uses credits); mock = fake, free (tests, CI, UI work).
ASR_PROVIDER=mock
TTS_PROVIDER=mock
# Gnani API key (sent as the X-API-Key-ID header). Get it at https://app.gnani.ai/voice/ . SERVER ONLY.
# Required only when ASR_PROVIDER or TTS_PROVIDER is gnani.
GNANI_API_KEY=
# Credit guard: total seconds of audio sent to Gnani per day (all shops). 0 = voice off.
GNANI_DAILY_LIMIT_SECONDS=600
# Longest clip accepted, in seconds (the app records at most 15).
VOICE_MAX_CLIP_SECONDS=15
# Optional, mock only: the sentence MockAsr "hears" for every clip.
# MOCK_ASR_TEXT=Ramesh ka kitna baaki hai?

# ------------------------------------------------------------------ Intent understanding (optional LLM)
# rules = built-in rules only (works offline, default) | llm = LLM only | auto = LLM first, rules if it fails.
INTENT_MODE=rules
# Any OpenAI-compatible chat-completions API (Gemini, Groq, OpenAI...). Leave empty to use rules only.
# Only the typed/heard TEXT plus customer/product names are sent to the LLM, never audio, never amounts to compute.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------------ Live tests (optional, never in CI)
# LIVE_TESTS=1 makes `pytest test_live.py` hit the real Supabase project as the demo user.
# LIVE_TESTS=
# LIVE_DEMO_PASSWORD=
